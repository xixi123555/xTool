# 可选：覆盖默认请求地址
# 开发环境默认走 Vite 代理；生产环境默认走同源反向代理。
# VITE_API_BASE=http://localhost:5198/api
# VITE_CHAT_API_BASE=http://localhost:5298/api
# VITE_CHAT_SOCKET_URL=http://localhost:5298

# 设置页展示的 MCP 地址
# VITE_MCP_URL=https://mcp.example.com/mcp

# Dify 工作流地址（翻译、网页阅读）
# VITE_DIFY_API_URL=https://api.dify.ai/v1/workflows/run
