#!/usr/bin/expect -f
# 密码通过环境变量传入，不出现在进程 argv 中。
# 由 lib/ssh.sh 调用：XT_SSH_HOST / USER / PORT / PASSWORD / COMMAND。

set timeout 1800

set host $env(XT_SSH_HOST)
set user $env(XT_SSH_USER)
set port $env(XT_SSH_PORT)
set remote $env(XT_SSH_COMMAND)

set cmd [list ssh \
  -o StrictHostKeyChecking=accept-new \
  -o ConnectTimeout=15 \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=10 \
  -o NumberOfPasswordPrompts=1 \
  -p $port]

if {[info exists env(XT_SSH_IDENTITY)] && $env(XT_SSH_IDENTITY) ne ""} {
  lappend cmd -i $env(XT_SSH_IDENTITY)
}

lappend cmd "$user@$host"
if {$remote ne ""} {
  lappend cmd $remote
}

spawn -noecho {*}$cmd

expect {
  -re "(?i)are you sure you want to continue connecting" {
    send "yes\r"
    exp_continue
  }
  -re "(?i)password.*:" {
    send -- "$env(XT_SSH_PASSWORD)\r"
    exp_continue
  }
  -re "(?i)permission denied" {
    puts stderr "SSH 认证失败：请检查 XTOOL_DEPLOY_USER / XTOOL_DEPLOY_PASSWORD 或服务器密码登录策略"
    exit 255
  }
  timeout {
    puts stderr "SSH 连接超时：请检查服务器安全组是否放行端口 $port"
    exit 124
  }
  eof
}

catch wait result
set code [lindex $result 3]
if {$code eq ""} {
  exit 1
}
exit $code
